<svg xmlns="http://www.w3.org/2000/svg" width="900" height="700" viewBox="0 0 900 700"><defs><pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" fill="none" stroke="#c8d4bc" stroke-width="1"/></pattern><filter id="shadow"><feDropShadow dx="0" dy="16" stdDeviation="15" flood-color="#334b35" flood-opacity=".13"/></filter></defs><rect width="900" height="700" rx="40" fill="#e8eedf"/><rect width="900" height="700" fill="url(#grid)"/><g transform="translate(145 85) rotate(-9 220 260)" filter="url(#shadow)"><rect width="440" height="540" rx="12" fill="#f9e8f0" stroke="#d4a6bd" stroke-width="2"/><text x="40" y="65" font-family="Arial" font-size="28" fill="#98466e" font-weight="bold">My little word collection</text><g fill="#fff"><rect x="35" y="100" width="175" height="150" rx="14"/><rect x="230" y="100" width="175" height="150" rx="14"/><rect x="35" y="270" width="175" height="150" rx="14"/><rect x="230" y="270" width="175" height="150" rx="14"/></g><g font-family="Arial" font-size="22" text-anchor="middle" fill="#76445d"><text x="122" y="220">explore</text><text x="317" y="220">imagine</text><text x="122" y="390">create</text><text x="317" y="390">discover</text></g></g><g transform="translate(350 105) rotate(7 220 260)" filter="url(#shadow)"><rect width="410" height="525" rx="12" fill="#fffefa" stroke="#b2c59f" stroke-width="2"/><rect x="25" y="27" width="360" height="115" rx="12" fill="#e5eddc"/><text x="45" y="65" font-family="Arial" font-size="13" fill="#537947">ENGLISH / CREATIVE WORKSHEET</text><text x="45" y="104" font-family="Arial" font-size="32" font-weight="bold" fill="#40583b">A day in the garden</text><text x="33" y="178" font-family="Arial" font-size="17" fill="#40583b">Read. Imagine. Make it yours.</text><g stroke="#ccd6c3" stroke-width="2"><path d="M35 210H375M35 235H300M35 260H350"/></g><rect x="30" y="285" width="350" height="155" rx="12" fill="#faf0df"/><g transform="translate(60 300)"><path d="M50 105V40M135 105V23M225 105V48" stroke="#6a8f55" stroke-width="5"/><g fill="#d98bad"><circle cx="50" cy="40" r="23"/><circle cx="135" cy="23" r="24"/><circle cx="225" cy="48" r="21"/></g><g fill="#f9d584"><circle cx="50" cy="40" r="10"/><circle cx="135" cy="23" r="11"/><circle cx="225" cy="48" r="9"/></g><g fill="#88aa70"><ellipse cx="34" cy="80" rx="19" ry="8" transform="rotate(30 34 80)"/><ellipse cx="153" cy="70" rx="20" ry="9" transform="rotate(-30 153 70)"/></g></g><text x="35" y="479" font-family="Arial" font-size="16" fill="#537947">Your ideas belong on this page.</text></g><g transform="translate(100 540) rotate(-7)"><rect width="220" height="60" rx="30" fill="#4a7042"/><text x="110" y="38" text-anchor="middle" font-family="Arial" font-size="19" fill="white">made for your lesson</text></g><path d="M787 70l9 23 23 9-23 9-9 23-9-23-23-9 23-9Z" fill="#527f45"/></svg>